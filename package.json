{
  "name": "kibo-eye-studio",
  "version": "0.1.0",
  "description": "Professional eye animation studio for the Kibo ESP32-C6 robot companion (240x240 GC9A01 round display)",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "verify:eye-geometry": "npx tsx scripts/verifyEyeGeometryParity.ts"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.11",
    "acorn": "^8.18.0",
    "framer-motion": "^11.11.17",
    "gifuct-js": "^2.1.2",
    "immer": "^10.1.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.kibo.eyestudio",
    "productName": "Kibo  Studio",
    "files": [
      "out"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
